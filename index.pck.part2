  "once": {
    "producer": "R2 emits transitions/created rounds/footprint activation once; cannon shot field distinguishes rounds",
    "dispatcher": "Forward stable per-attempt event sequence token assigned once at emission/drain. Deduplicate same token before playback. Do not generate token on each delivery.",
    "current_payload_limit": "R2 has no unique event sequence/attack token and no cancel event. Identical future tell payloads cannot be deduped reliably by payload equality alone.",
    "cache": "One current IronWarden owner/attempt and bounded last-token state per finite event/pattern route; clear on attempt reset/owner exit",
    "throttle": "Finite tank:event:pattern keys; no enemyID/projectileID growing throttle map; defensive gap does not provide once-only semantics"
  },
  "cancellation": {
    "warning": "Stop owned warning/charge loop on actual cancel/death/state exit. No timer scheduled fire/blast from tell.",
    "projectiles": "Mortar/cannon and blast hazards are owner-bound; dead/missing/inactive owner cancels future cue requests",
    "state_order": "Do not require owner.phase=active for tank_fire: final cannon fire dispatches with owner already recover in same Model.step",
    "pause": "Immediate stop of tank one-shots/loops; cancel queued work, no replay on resume. Optional loop may resume only from current actual motion.",
    "terminal": "Stop tank voice group before dying/over/title/retry cleanup; terminal cues retain semanticpriority4; approved music selection/cursors remain unchanged"
  },

  },
  "guards": {
    "sfx": [
      "master muted",
      "effects volume zero",
      "SFX disabled",
      "app hidden",
      "tree paused",
      "explicit pause"
    ],
    "modal": "Semantic menu input follows existing title/pause Options modal rules; no simulation resume",
    "pending": "Cancel timers and voice; no queue replay when focus/mute/pause clears"
  },
  "music_duck": {
    "optional": true,
    "db": -8,
    "attack_seconds": 0.04,
    "release_seconds": 0.22,
    "target": "Existing intro music gain envelope only while accepted voice active",
    "controls": "Multiplier on current music target; preserve music volume, enable, mute, transport/cursor",
    "restore": "Recompute latest music target on completion/cancel/guard; no stale cached volume; no permanent gain edit"
  },
  "dependencies": "Speech seed WAVs retained under sources for editable recipe rebuild. Runtime needs baked WAVs only; no Windows speech on target platform.",
  "no_runtime_edits": true,
  "approved_music_unchanged": true,
  "ui_contracts": [
    "res://assets/ui-production/startup-credit-contract-v1.md",
    "res://assets/ui-production/hero-selection-events-v1.md",
    "res://assets/ui-production/character-lock-contract-v1.md"
  ],
  "semantic_bindings": [
    {
      "event": "title_menu_visible",
      "when": "reason=cold_start and new entry_id",
      "asset": "startup_title_sting_v1"
    },
    {
      "event": "menu_focus_changed",
      "when": "actual actionable focus change; reason!=activation; dedupe intent_id",
      "asset": "startup_focus_nav_v1"
    },
    {
      "event": "menu_action_accepted",
      "when": "screen=title, action_id=start_game and actual title->select transition",
      "assets": [
        "startup_confirm_v1",
        "startup_deltanova_voice_v1"
      ],
      "voice_delay_seconds": 0.1
    },
    {
      "event": "hero_selection_changed",
      "when": "joined active unlocked slot actual species change; valid canonical mapping",
      "asset": "heroes[species_id].id",
      "settle_seconds_per_player": 0.18,
      "immediate_nav": "One navigation cue only if this intent has not already produced focus navigation or accepted action cue; thumbnail hero activation never confirm"
    },
    {
      "event": "character_lock_accepted",
      "when": "selecting->locked; intent_id not consumed",
      "asset": "startup_confirm_v1"
    },
    {
      "event": "character_unlock_accepted",
      "when": "locked->selecting; intent_id not consumed",
      "asset": "startup_unlock_v1"
    },
    {
      "event": "deploy_accepted",
      "when": "separate accepted fresh action; required slots ready",
      "asset": "startup_confirm_v1",
      "cancel_voices": true
    }
  ],
  "action_dedupe": "Dedicated character_lock/unlock/deploy events are authoritative. A generic menu_action_accepted with the same intent_id cannot add a second cue. Hero activation is navigation/hero-change, never lock confirm. Boot skip never Start/confirm voice."
}␀␀␀␀␀␀␀␀RIFF_␀WAVEfmt ␀␀␀␀␀D¬␀␀ˆX␀␀␀datal_␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ÿÿÿÿ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ÿÿÿÿÿÿÿÿ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ÿÿÿÿÿÿÿÿ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ÿÿÿÿÿÿÿÿ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ÿÿ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ÿÿ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ÿÿ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ÿÿ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ÿÿÿÿÿÿÿÿ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ÿÿÿÿÿÿ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ÿÿÿÿÿÿÿÿ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ÿÿÿÿşÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿ␀␀ÿÿÿÿÿÿÿÿÿÿÿÿÿÿ␀␀␀␀␀␀␀␀ÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀şÿüÿûÿûÿüÿüÿûÿøÿõÿóÿóÿõÿ÷ÿøÿöÿóÿîÿëÿêÿìÿóÿùÿşÿ␀␀şÿúÿõÿòÿñÿòÿóÿóÿóÿóÿóÿôÿöÿø
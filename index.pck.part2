ã¹Õş> #„ß®1}‚}‚Éh3=‡j‡®³ì:í†çÙÆ‡uš‹VI».Cú®gËÁí)ó¿_è;|êcı€¯‰␀†¡ïÔ]À’Ô~"~½$˜%,×ôe>Ÿ€U¼qF£ş¡o¹¥˜pÔ†nf¯—U}å_=Şò®mqòAİ␀␀␀␀␀shader_type canvas_item;
render_mode unshaded;
uniform float grade_strength : hint_range(0.0,1.0)=0.0;
uniform vec3 atmosphere=vec3(0.07,0.11,0.18);
uniform float arena_padding=0.0;
void fragment(){
	vec4 pixel=texture(TEXTURE,UV);
	// This viewport is sampled in display RGB in Compatibility CanvasItem.
	// Verify against the approved CPU reference rather than assume linear values.
	float luma=dot(pixel.rgb,vec3(0.2126,0.7152,0.0722));
	vec3 graded=mix(vec3(luma),pixel.rgb,0.72);
	graded=((graded-vec3(0.10))*0.82+vec3(0.10))*0.94;
	graded=mix(graded,atmosphere,0.06);
	float y=UV.y/TEXTURE_PIXEL_SIZE.y;
	float inside=step(arena_padding,y)*(1.0-step(arena_padding+270.0,y));
	COLOR=vec4(mix(pixel.rgb,clamp(graded,vec3(0.0),vec3(1.0)),grade_strength*inside),pixel.a);
}
